{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "react"],
    "paths": {
      "@zana-ai/zcc-plugin-sdk": [
        "../../packages/plugin-sdk/src/index.ts"
      ],
      "@zana-ai/zcc-plugin-sdk/app": [
        "../../packages/plugin-sdk/src/app.ts"
      ]
    }
  },
  "include": [
    "server.ts",
    "app.tsx",
    "src/extension-ui-contract.ts"
  ]
}
